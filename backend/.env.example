# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/hrm_system

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_access_key
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key

# Client CORS Origins (comma separated or single URL)
CLIENT_URL=http://localhost:5173

# Optional AI Provider (Default is high-performance deterministic engine)
# AI_PROVIDER=openai # Options: 'openai', 'anthropic', 'gemini'
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=your_optional_api_key_here
